# ── App ───────────────────────────────────────────────
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080

# ── Database (MySQL studyonline_db hiện có) ────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=studyonline_db
DB_USER=root
DB_PASS=

# ── JWT (giữ trùng secret với bản PHP để token cũ còn hiệu lực) ──
JWT_SECRET=studyonline_super_secret_key_2026
JWT_EXPIRE=604800

# ── HTTP / CORS / Upload ──────────────────────────────
FRONTEND_ORIGIN=*
UPLOAD_DIR=./uploads
PUBLIC_BASE_URL=http://127.0.0.1:8080

# ── AI (dùng từ Phase 6 trở đi) ────────────────────────
# LLM_PROVIDER: gemini | openai | claude (để trống / không có LLM_API_KEY -> chế độ
# trích xuất offline). LLM_MODEL để trống sẽ dùng model mặc định của provider
# (claude -> claude-opus-5).
# LLM_BASE_URL (chỉ dùng với LLM_PROVIDER=openai): trỏ tới dịch vụ cùng chuẩn API OpenAI, vd.
#   Ollama trên máy: http://localhost:11434/v1   (LLM_MODEL=qwen2.5:7b, không cần key)
#   Groq:            https://api.groq.com/openai/v1
#   DeepSeek:        https://api.deepseek.com/v1
#   OpenRouter:      https://openrouter.ai/api/v1
LLM_PROVIDER=gemini
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
VECTOR_DB_PATH=./data/chroma
BASE_MODEL=Qwen/Qwen2.5-1.5B-Instruct
LORA_ADAPTER_PATH=
AI_MAX_CONTEXT_CHUNKS=5
RAG_SIMILARITY_THRESHOLD=0.55
RAG_MAX_QUESTION_LENGTH=2000

# ── Thanh toán VNPay Sandbox ──────────────────────────
# Đăng ký tài khoản test tại https://sandbox.vnpayment.vn/devreg/ để nhận TMN code + hash secret.
# Để trống -> nút thanh toán báo "chưa cấu hình VNPay".
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# VNPay đưa trình duyệt về API này sau khi thanh toán; backend kiểm tra rồi chuyển về FRONTEND_URL
VNPAY_RETURN_URL=http://127.0.0.1:8080/api/payments/vnpay/return
FRONTEND_URL=http://localhost:5173
# true = bật lại thanh toán giả lập (không qua VNPay) cho khóa có phí — chỉ để demo offline
PAYMENT_MOCK=false
# Chu kỳ (giây) tự đối soát đơn VNPay đang chờ đã quá hạn với VNPay (querydr); 0 = tắt
PAYMENT_RECONCILE_INTERVAL=300
